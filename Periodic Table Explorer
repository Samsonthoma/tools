// Build grid with placeholders for empty cells
(function buildGrid(){
  const grid = document.getElementById('pte-grid');

  // Create 10 rows: 1–7 main, 9 lanthanides, 10 actinides (row 8 is visual spacer)
  const TOTAL_ROWS = 10;
  const TOTAL_COLS = 18;

  // Create an empty matrix
  const matrix = Array.from({length: TOTAL_ROWS}, () => Array(TOTAL_COLS).fill(null));

  // Place elements
  ELEMENTS.forEach(e => {
    const r = e.row - 1; // zero-based
    const c = e.col - 1;
    matrix[r][c] = e;
  });

  // Render cells
  for (let r = 0; r < TOTAL_ROWS; r++) {
    for (let c = 0; c < TOTAL_COLS; c++) {
      const cell = document.createElement('div');
      cell.style.border = '1px solid #ddd';
      cell.style.minHeight = '56px';
      cell.style.background = '#fff';
      cell.style.display = 'flex';
      cell.style.flexDirection = 'column';
      cell.style.alignItems = 'center';
      cell.style.justifyContent = 'center';
      cell.style.padding = '6px';
      cell.style.borderRadius = '6px';
      cell.style.fontSize = '12px';
      cell.style.position = 'relative';

      const el = matrix[r][c];
      if (el) {
        const bg = CATEGORY_COLOR[el.cat] || '#fff';
        cell.style.background = bg;

        const num = document.createElement('div');
        num.textContent = el.n;
        num.style.position = 'absolute';
        num.style.top = '4px';
        num.style.left = '6px';
        num.style.fontSize = '10px';
        num.style.color = '#555';

        const sym = document.createElement('div');
        sym.textContent = el.s;
        sym.style.fontWeight = 'bold';
        sym.style.fontSize = '16px';
        sym.style.color = '#222';

        cell.appendChild(num);
        cell.appendChild(sym);

        cell.style.cursor = 'pointer';
        cell.title = `${el.name} (${el.s})`;

        cell.addEventListener('click', () => openModal(el));
      } else {
        cell.style.background = 'transparent';
        cell.style.border = 'none';
      }

      grid.appendChild(cell);
    }
  }

  // Add labels for lanthanides/actinides rows
  const labelStyle = 'grid-column: 1; display:flex; align-items:center; justify-content:center; font-size:12px; color:#555; writing-mode: vertical-rl;';
  const lanLabel = document.createElement('div');
  lanLabel.setAttribute('style', labelStyle);
  lanLabel.textContent = 'Lanthanides';
  grid.insertBefore(lanLabel, grid.children[(9-1)*TOTAL_COLS]); // before row 9

  const actLabel = document.createElement('div');
  actLabel.setAttribute('style', labelStyle);
  actLabel.textContent = 'Actinides';
  grid.insertBefore(actLabel, grid.children[(10-1)*TOTAL_COLS]); // before row 10
})();

function openModal(el){
  document.getElementById('pte-modal-title').textContent = `${el.s} - ${el.name}`;
  document.getElementById('pte-modal-symbol').textContent = el.s;
  document.getElementById('pte-modal-name').textContent = el.name;
  document.getElementById('pte-modal-number').textContent = el.n;
  document.getElementById('pte-modal-mass').textContent = el.mass;
  document.getElementById('pte-modal-category').textContent = el.cat[0].toUpperCase() + el.cat.slice(1);
  document.getElementById('pte-modal').style.display = 'flex';
}
  
 // Search
document.getElementById('pte-search').addEventListener('input', function () {
  const q = this.value.toLowerCase();
  const grid = document.getElementById('pte-grid');

  Array.from(grid.children).forEach(cell => {
    if (!cell.dataset.name) return; // skip empty cells

    const match =
      cell.dataset.name.includes(q) ||
      cell.dataset.symbol.includes(q);

    cell.style.display = match ? 'flex' : 'none';
  });
});

